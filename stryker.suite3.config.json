{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Configuración de mutation testing para la suite 3.",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/suite3.html"
  },
  "testRunner": "jest",
  "jest": {
    "enableFindRelatedTests": true,
    "config": {
      "testEnvironment": "node",
      "testRegex": ".*(cart|cartService)\\.suite3\\.test\\.js$"
    }
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "./**/*.js",
    "!tests/**/*.js",
    "!node_modules/**/*.js",
    "coverage/**/*.js",
    "reports/**/*.js"
  ]
}
