{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Archivo de configuración de Stryker para mutaciones en el proyecto.",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/suite1.html"
  },
  "testRunner": "jest",
  "jest": {
    "enableFindRelatedTests": true,
    "config": {
      "testEnvironment": "node",
      "testRegex": ".*(cart|cartService)\\.suite1\\.test\\.js$"
    }
  },
  "testRunner_comment": "Take a look at https://stryker-mutator.io/docs/stryker-js/jest-runner for information about the jest plugin.",
  "coverageAnalysis": "perTest",
  "mutate": [
    "./**/*.js",
    "!tests/**/*.js",
    "!node_modules/**/*.js",
    "coverage/**/*.js",
    "reports/**/*.js"
  ]
}